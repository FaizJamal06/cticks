rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function group(gid) { return get(/databases/$(database)/documents/groups/$(gid)).data; }
    function isMember(gid) { return signedIn() && me() in group(gid).members; }

    // Today's date in India time, as "YYYY-MM-DD" — the only day you're allowed to tick.
    function pad(n) { return n < 10 ? '0' + string(n) : string(n); }
    function istToday() {
      let t = request.time + duration.value(330, 'm');
      return string(t.year()) + '-' + pad(t.month()) + '-' + pad(t.day());
    }

    // Group settings the ledger depends on. A bad stake shows ₹NaN; a bad rule/days breaks scoring.
    function validGroup(d) {
      return d.stake is number && d.stake > 0 && d.stake <= 100000
        && d.rule in ['all', 'none']
        && d.days in [7, 14, 21, 30]
        && d.round is int
        && (!('penaltyMode' in d) || d.penaltyMode in ['money', 'dare'])
        && validNext(d);
    }
    // Settings queued for the next round (Pay or Dare mode, and any mode switch).
    function validNext(d) {
      return !('next' in d) || (d.next is map
        && d.next.keys().hasOnly(['penaltyMode', 'stake', 'rule'])
        && (!('penaltyMode' in d.next) || d.next.penaltyMode in ['money', 'dare'])
        && (!('stake' in d.next) || (d.next.stake is number && d.next.stake > 0 && d.next.stake <= 100000))
        && (!('rule' in d.next) || d.next.rule in ['all', 'none']));
    }
    // Written only by the server (admin SDK): who's out, the mode in force, an early round end, the winner.
    function serverOnly() { return ['kicked', 'penaltyMode', 'endedEarly', 'winner', 'checkedOn']; }
    // 1–8 tasks. Zero tasks would mean isMiss() is always false: a player who can never owe.
    function validTasks(d) { return d.tasks is list && d.tasks.size() >= 1 && d.tasks.size() <= 8; }

    // Your own profile + push tokens. Only you (and the server) can see them.
    match /users/{uid} {
      allow read, write: if signedIn() && me() == uid;
    }

    match /groups/{gid} {
      // Anyone signed in can look up a group by its invite code (the doc id), never list them.
      allow get: if signedIn();
      allow list: if false;

      // A new group may pick its penalty mode; nothing else server-only exists yet.
      allow create: if signedIn()
        && request.resource.data.members == [me()]
        && request.resource.data.createdBy == me()
        && !request.resource.data.keys().hasAny(['kicked', 'endedEarly', 'winner', 'checkedOn', 'next'])
        && validGroup(request.resource.data);

      // Phase A of Pay or Dare (docs/PENALTIES_SPEC.md 7.3): additive, so the app on main keeps working.
      // Phase B (after the merge) narrows the member path to stake / rule / next and makes round starts server-only.
      allow update: if validGroup(request.resource.data) && (
        // members can change stake / rule / rounds / next, but not who's in the group, and never server-only fields
        (isMember(gid) && request.resource.data.members == resource.data.members
          && request.resource.data.createdBy == resource.data.createdBy
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(serverOnly()))
        // someone with the code can add exactly themselves (max 6 people). Someone who's been kicked can't:
        // they come back through the server, which resets their `joined` date (/api/group rejoin).
        || (signedIn() && !(me() in resource.data.members)
          && !(me() in resource.data.get('kicked', {}))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members == resource.data.members.concat([me()])
          && resource.data.members.size() < 6));

      allow delete: if false;

      // Each player's tasks + ticks. Everyone in the group reads; ONLY you write yours,
      // and only today's ticks can change — no backfilling yesterday.
      // `joined` can't be in the future (days before it never count) and never changes after.
      match /players/{uid} {
        allow read: if isMember(gid);
        allow create: if isMember(gid) && me() == uid
          && request.resource.data.uid == uid
          && request.resource.data.checks == {}
          && request.resource.data.joined is string && request.resource.data.joined <= istToday()
          && validTasks(request.resource.data);
        allow update: if isMember(gid) && me() == uid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['joined', 'uid'])
          && validTasks(request.resource.data)
          && request.resource.data.get('checks', {}).diff(resource.data.get('checks', {})).affectedKeys().hasOnly([istToday()]);
        allow delete: if false;
      }

      // Activity feed. Append-only, and you can only post as yourself.
      match /feed/{fid} {
        allow read: if isMember(gid);
        allow create: if isMember(gid) && request.resource.data.by == me();
        allow update, delete: if false;
      }

      // Pay or Dare: penalties, their votes, and the dare deck. Members read; only the server writes
      // (every action goes through an API route that checks the ID token and the state machine).
      match /penalties/{pid} {
        allow read: if isMember(gid);
        allow write: if false;
        match /votes/{vid} {
          allow read: if isMember(gid);
          allow write: if false;
        }
      }
      match /dares/{did} {
        allow read: if isMember(gid);
        allow write: if false;
      }
    }
  }
}
